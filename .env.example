# Environment Variables — EcoSphere AI

# Copy this file to `.env.local` for local development.
# Never commit actual secrets to version control.

# ─── Google Cloud ───────────────────────────────────────────────────────────
VITE_GOOGLE_CLOUD_PROJECT=your-project-id
VITE_GOOGLE_CLOUD_REGION=us-central1

# ─── Gemini AI (Google AI Studio or Vertex AI) ──────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_MODEL=gemini-2.5-flash

# ─── Firebase Authentication ────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# ─── Application Settings ────────────────────────────────────────────────────
# Base URL for the backend API (defaults to relative /api in production)
VITE_API_URL=/api

# Enable debug logging (set to "true" in development only)
VITE_DEBUG=false

# ─── Security ────────────────────────────────────────────────────────────────
# Rate limiting: maximum login attempts per window
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_LOGIN_RATE_WINDOW_MS=900000
